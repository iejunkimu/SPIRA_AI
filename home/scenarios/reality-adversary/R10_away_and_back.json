{
  "name": "R10_away_and_back",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "submit",
      "body": {
        "temporary": true,
        "restore": true
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "VERIFIED"
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false
        }
      }
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": true
        }
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "OVERRIDDEN"
    },
    {
      "op": "end"
    },
    {
      "op": "assert",
      "invariant": "I5",
      "path": [
        "world",
        "mqtt:light",
        "values",
        "power"
      ],
      "equals": true
    },
    {
      "op": "assert",
      "invariant": "I6",
      "path": [
        "tasks",
        "a",
        "restore_status"
      ],
      "equals": "RESTORE_SKIPPED_OVERRIDE"
    }
  ]
}
