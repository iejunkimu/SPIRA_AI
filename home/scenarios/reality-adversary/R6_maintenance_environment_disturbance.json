        "seed": 6
      },
      "disturbances": [
        0,
        0,
        15,
        0,
        0
      ]
    },
    {
      "op": "assert",
      "invariant": "I11",
      "path": [
        "tasks",
        "a",
        "restore_status"
      ],
      "equals": null
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:humidity",
        "values": {
          "humidity": 50
        }
      }
    },
    {
      "op": "tick"
    },
    {
      "op": "advance",
      "seconds": 5
    },
    {
      "op": "assert",
      "invariant": "I6",
      "path": [
        "tasks",
        "a",
        "restore_status"
      ],
      "equals": "RESTORED"
    },
    {
      "op": "assert",
      "invariant": "I12",
      "path": [
        "world",
        "mqtt:conditioner",
        "values",
