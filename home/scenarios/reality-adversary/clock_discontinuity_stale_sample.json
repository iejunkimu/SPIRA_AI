{
  "name": "clock_discontinuity_stale_sample",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:humidity",
        "values": {
          "humidity": 50
        }
      }
    },
    {
      "op": "submit",
      "body": {
        "trigger": {
          "type": "state.v1",
          "condition": {
            "target": "mqtt:humidity",
            "property": "humidity",
            "maximum": 55,
            "stable_seconds": 5
          }
        }
      }
    },
    {
      "op": "tick"
    },
    {
      "op": "fault",
      "body": {
        "id": "old-sensor",
        "target": "mqtt:humidity",
        "stale": true,
        "stage": "before",
        "hold": true
      }
    },
    {
      "op": "boundary",
      "id": "old-sensor"
    },
    {
      "op": "clock_jump",
      "seconds": 20
    },
    {
      "op": "release",
      "id": "old-sensor"
    },
    {
      "op": "tick"
    },
    {
      "op": "assert",
      "invariant": "I11",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "WAITING"
    }
  ]
}
