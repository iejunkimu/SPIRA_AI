{
  "name": "deadline_during_delayed_dispatch_read",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "fault",
      "body": {
        "id": "deadline-read",
        "stage": "before",
        "hold": true
      }
    },
    {
      "op": "submit",
      "body": {
        "deadline_seconds": 1
      }
    },
    {
      "op": "boundary",
      "id": "deadline-read"
    },
    {
      "op": "clock_jump",
      "seconds": 2
    },
    {
      "op": "release",
      "id": "deadline-read"
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "EXPIRED"
    },
    {
      "op": "assert",
      "invariant": "I4",
      "path": [
        "commands"
      ],
      "equals": 0
    }
  ]
}
