{
  "name": "external_before_fresh_verification",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "fault",
      "body": {
        "id": "fresh-verify",
        "skip": 1,
        "stage": "before",
        "hold": true
      }
    },
    {
      "op": "submit",
      "body": {
        "temporary": true,
        "restore": true
      }
    },
    {
      "op": "boundary",
      "id": "fresh-verify"
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false
        }
      }
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": true
        }
      }
    },
    {
      "op": "release",
      "id": "fresh-verify"
    },
    {
      "op": "settle"
    },
    {
      "op": "end"
    },
    {
      "op": "assert",
      "invariant": "I6",
      "path": [
        "world",
        "mqtt:light",
        "values",
        "power"
      ],
      "equals": true
    },
    {
      "op": "assert",
      "invariant": "I5",
      "path": [
        "tasks",
        "a",
        "restore_status"
      ],
      "equals": "RESTORE_SKIPPED_OVERRIDE"
    }
  ]
}
