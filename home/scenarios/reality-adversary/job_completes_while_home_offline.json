{
  "name": "job_completes_while_home_offline",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:robot_01",
        "mode": "normal",
        "values": {
          "run_state": "idle",
          "job_id": null,
          "done_today": false
        }
      }
    },
    {
      "op": "submit",
      "body": {
        "target": "mqtt:robot_01",
        "family": "RUN_JOB",
        "desired": {
          "run_state": "running",
          "room": "living"
        },
        "temporary": true,
        "restore": true
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "RUNNING"
    },
    {
      "op": "process",
      "action": "kill"
    },
    {
      "op": "clock_jump",
      "seconds": 95
    },
    {
      "op": "process",
      "action": "start"
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "COMPLETED"
    },
    {
      "op": "assert",
      "invariant": "I10",
      "path": [
        "commands"
      ],
      "equals": 1
    },
    {
      "op": "assert",
      "invariant": "I1",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "COMPLETED"
    }
  ]
}
