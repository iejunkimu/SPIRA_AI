{
  "name": "job_replacement_during_stop",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:robot_01",
        "mode": "normal",
        "values": {
          "run_state": "idle",
          "job_id": null,
          "done_today": false
        }
      }
    },
    {
      "op": "submit",
      "body": {
        "target": "mqtt:robot_01",
        "family": "RUN_JOB",
        "desired": {
          "run_state": "running",
          "room": "living"
        }
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "RUNNING"
    },
    {
      "op": "fault",
      "body": {
        "id": "stop-job",
        "target": "mqtt:robot_01",
        "kind": "command",
        "stage": "before",
        "hold": true
      }
    },
    {
      "op": "end",
      "async": true
    },
    {
      "op": "boundary",
      "id": "stop-job"
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:robot_01",
        "values": {
          "job_id": "external-job"
        }
      }
    },
    {
      "op": "release",
      "id": "stop-job"
    },
    {
      "op": "join"
    },
    {
      "op": "assert",
      "invariant": "I12",
      "path": [
        "world",
        "mqtt:robot_01",
        "values",
        "run_state"
      ],
      "equals": "running"
    },
    {
      "op": "assert",
      "invariant": "I5",
      "path": [
        "world",
        "mqtt:robot_01",
        "values",
        "job_id"
      ],
      "equals": "external-job"
    }
  ]
}
