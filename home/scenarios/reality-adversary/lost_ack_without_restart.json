{
  "name": "lost_ack_without_restart",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "fault",
      "body": {
        "id": "lost-ack",
        "kind": "command",
        "drop": true
      }
    },
    {
      "op": "submit",
      "body": {
        "retry": {
          "max_attempts": 3
        }
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "INDETERMINATE"
    },
    {
      "op": "advance",
      "seconds": 3
    },
    {
      "op": "assert",
      "invariant": "I3",
      "path": [
        "commands"
      ],
      "equals": 1
    }
  ]
}
