{
  "name": "partial_sibling_precheck",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:washer",
        "mode": "normal",
        "values": {
          "in_use": false
        }
      }
    },
    {
      "op": "fault",
      "body": {
        "id": "missing-in-use",
        "target": "mqtt:washer",
        "omit": [
          "in_use"
        ]
      }
    },
    {
      "op": "submit",
      "body": {
        "prechecks": [
          {
            "kind": "not_in_use",
            "target": "mqtt:washer"
          }
        ]
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "BLOCKED"
    },
    {
      "op": "assert",
      "invariant": "I2",
      "path": [
        "commands"
      ],
      "equals": 0
    }
  ]
}
