{
  "name": "stop_during_delayed_dispatch_read",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "fault",
      "body": {
        "id": "stop-read",
        "stage": "before",
        "hold": true
      }
    },
    {
      "op": "submit",
      "body": {}
    },
    {
      "op": "boundary",
      "id": "stop-read"
    },
    {
      "op": "stop",
      "async": true
    },
    {
      "op": "release",
      "id": "stop-read"
    },
    {
      "op": "join"
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "CANCELLED"
    },
    {
      "op": "assert",
      "invariant": "I4",
      "path": [
        "commands"
      ],
      "equals": 0
    }
  ]
}
