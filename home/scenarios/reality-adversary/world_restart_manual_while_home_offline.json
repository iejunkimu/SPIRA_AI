{
  "name": "world_restart_manual_while_home_offline",
  "steps": [
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false,
          "brightness": 10
        }
      }
    },
    {
      "op": "submit",
      "body": {
        "temporary": true,
        "restore": true
      }
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "VERIFIED"
    },
    {
      "op": "process",
      "action": "kill"
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": false
        }
      }
    },
    {
      "op": "mutate",
      "body": {
        "target": "mqtt:light",
        "mode": "normal",
        "values": {
          "power": true
        }
      }
    },
    {
      "op": "process",
      "action": "restart",
      "target": "world"
    },
    {
      "op": "process",
      "action": "start"
    },
    {
      "op": "wait",
      "path": [
        "tasks",
        "a",
        "status"
      ],
      "equals": "OVERRIDDEN"
    },
    {
      "op": "end"
    },
    {
      "op": "assert",
      "invariant": "I10",
      "path": [
        "commands"
      ],
      "equals": 1
    },
    {
      "op": "assert",
      "invariant": "I5",
      "path": [
        "world",
        "mqtt:light",
        "values",
        "power"
      ],
      "equals": true
    }
  ]
}
