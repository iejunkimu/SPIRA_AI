# Copy to .env and fill in locally. Never commit .env.

# Server DB (local docker compose default shown)
DATABASE_URL=postgresql://spira:spira@localhost:5432/spira

# Knowledge base DB, read-only account (KB-13)
KB_DATABASE_URL=
# Knowledge base DB, owner account, migrations only (Seojin)
KB_MIGRATION_URL=
# Knowledge base version to search, e.g. kb-v1 (KB-11)
KB_VERSION=

# LLM
LLM_MODEL=
LLM_API_KEY=

# Evaluation switches (spec S2)
KB_MODE=on
HOME_CONTEXT=on
KB_SAMPLE=1.0
